# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=rag_forensics

# Embedding Configuration (Options: local, gemini)
# local uses sentence-transformers/all-MiniLM-L6-v2 (free, fast, CPU)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Chunking and Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# Application Settings
MAX_UPLOAD_SIZE_MB=25
DEBUG_MODE=true
STORAGE_DIR=storage
